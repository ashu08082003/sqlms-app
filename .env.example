# ============================================================
# SQLMS — Smart QR Logbook Management System
# Environment Variables
# ============================================================

# --- Database ---
# Local (SQLite):
DATABASE_URL=file:./db/custom.db
# Railway / Production (PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Email / SMTP (optional — overrides Email Settings in the admin UI) ---
# When set, these are applied to the database on every container start,
# so emails are sent for real (no need to enter them in the UI).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=SQLMS Logbook
REPORT_TO_EMAIL=reports@yourcompany.com
ESCALATION_TO_EMAIL=maintenance@yourcompany.com
ENABLE_REPORT_EMAIL=true
ENABLE_ESCALATION=true
# IMPORTANT: keep false to actually send emails. Set true to only log them.
SIMULATE_ONLY=false

