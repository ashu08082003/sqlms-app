// Smart QR Logbook Management System (SQLMS)
// Digital Inspection & Maintenance System (DIMS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("EMPLOYEE") // ADMIN | EMPLOYEE
  employeeCode String?     @unique
  phone        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  inspections Inspection[]
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users     User[]
  locations Location[]
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  icon        String      @default("Factory")
  color       String      @default("#0d9488")
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  checklists Checklist[]
  locations  Location[]
}

model Checklist {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description String?
  frequency   String   @default("DAILY") // DAILY | WEEKLY | MONTHLY | QUARTERLY
  // JSON array of checklist item labels: ["Greasing", "Oil Level", ...]
  items       String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations   Location[]
  inspections Inspection[]
}

model Location {
  id           String      @id @default(cuid())
  qrCode       String      @unique // e.g. QR000124
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String // e.g. "Slitting Line"
  machineName  String // e.g. "Slitter-01"
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  checklistId  String?
  checklist    Checklist?  @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  frequency    String      @default("DAILY")
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  inspections Inspection[]
}

model Inspection {
  id           String    @id @default(cuid())
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistId  String?
  checklist    Checklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  inspectionDate DateTime @default(now())
  // JSON array of responses: [{ item, status: "OK"|"NOT_OK"|"NA", reason?, photoUrl? }]
  responses    String    @default("[]")
  remarks      String?
  photoUrl     String?
  passedCount  Int       @default(0)
  failedCount  Int       @default(0)
  naCount      Int       @default(0)
  score        Float     @default(0) // percentage of OK among OK+NOT_OK
  status       String    @default("COMPLETED") // COMPLETED | OVERDUE_PENDING
  createdAt    DateTime  @default(now())

  emails EmailLog[]
}

// Model to track cumulative report generation state per location per period
model CumulativeReport {
  id            String   @id @default(cuid())
  locationId    String
  frequency     String   // DAILY | WEEKLY | MONTHLY | QUARTERLY
  cycleKey      String   // e.g. "2026-01", "2026-Q1", "2026"
  status        String   @default("ACTIVE") // ACTIVE | FINALIZED | SENT
  lastGeneratedAt DateTime?
  lastEmailedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([locationId, frequency, cycleKey])
}

// Singleton-style email configuration (one row, key = "global")
model EmailSetting {
  id                String   @id @default(cuid())
  key               String   @unique @default("global")
  // Recipients
  reportToEmail     String   @default("") // where completed reports go
  escalationToEmail String   @default("") // where NOT OK escalations go
  // SMTP
  smtpHost          String   @default("")
  smtpPort          Int      @default(587)
  smtpUser          String   @default("")
  smtpPass          String   @default("")
  fromEmail         String   @default("")
  fromName          String   @default("SQLMS Logbook")
  // Toggles
  enableReportEmail   Boolean @default(true)
  enableEscalation    Boolean @default(true)
  // If true, emails are logged as SIMULATED without attempting SMTP send
  simulateOnly      Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model EmailLog {
  id            String      @id @default(cuid())
  to            String
  subject       String
  bodyHtml      String
  status        String      @default("SIMULATED") // SENT | FAILED | SIMULATED
  type          String      @default("REPORT") // REPORT | ESCALATION
  inspectionId  String?
  inspection    Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  error         String?
  createdAt     DateTime    @default(now())
}
